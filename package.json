{
  "name": "tandem",
  "productName": "Tandem",
  "version": "0.7.1",
  "description": "Tandem — usage tracker for Claude. Follows several accounts and switches to the one in use.",
  "author": "Abraham Agüero",
  "license": "MIT",
  "homepage": "https://github.com/abrahamaguero/tandem-claude-usage",
  "repository": {
    "type": "git",
    "url": "https://github.com/abrahamaguero/tandem-claude-usage.git"
  },
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg --universal"
  },
  "build": {
    "appId": "com.klugeinteractive.tandem",
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Tandem-${version}-mac.dmg"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
